{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "build-or-bite",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "game.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true
  },
  "scripts": {
    "dev": "vite build --watch --config vite.config.devvit.ts",
    "build": "vite build --config vite.config.devvit.ts"
  }
}
