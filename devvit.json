{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "build-or-bite",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "tall"
      },
      "game": {
        "entry": "game.html",
        "height": "tall"
      },
      "run": {
        "entry": "run.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true
  },
  "menu": {
    "items": [
      {
        "label": "Create Build or Bite post",
        "description": "Create a playable Build or Bite game post in this community.",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/menu/create-game-post"
      }
    ]
  },
  "scripts": {
    "dev": "vite build --watch --config vite.config.devvit.ts",
    "build": "vite build --config vite.config.devvit.ts"
  }
}
